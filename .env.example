# ==============================================
# KWOT Finance - Environment Variables
# ==============================================
# Copy this file to .env.local and fill in values
# cp .env.example .env.local

# --- Database (Required) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Authentication (Required for production) ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Optional: restrict login to specific email domains
# AUTH_ALLOWED_DOMAINS="kwot.fr,sheriff.fr"

# --- Navigator v1 Webhook (Required for sync) ---
NAVIGATOR_WEBHOOK_SECRET="your-strong-secret-here"

# --- Email (Optional - required for sending invoices/quotes) ---
# RESEND_API_KEY="re_..."
# EMAIL_FROM="KWOT Finance <finance@yourdomain.com>"

# --- Error Tracking (Optional - recommended for production) ---
# SENTRY_DSN="https://...@sentry.io/..."
# NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# --- App URL ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
