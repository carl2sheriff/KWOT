// KWOT CRM - Database Schema
// Generator and datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  CREDITED
}

enum CreditNoteStatus {
  DRAFT
  SENT
  APPLIED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHECK
  CARD
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum POStatus {
  DRAFT
  SENT
  CONFIRMED
  RECEIVED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  APPROVE
  REJECT
  SEND
  PAYMENT
  CREDIT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum SupplierInvoiceStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

// ============================================
// USERS & AUTH
// ============================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String
  role          String    @default("user") // admin, manager, user
  avatar        String?
  hourlyRate    Decimal?  @map("hourly_rate") @db.Decimal(10, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  clients       Client[]
  projects      Project[]
  tasks         Task[]

  // Financial relations
  timeEntries    TimeEntry[]
  expenses       Expense[]
  quotesCreated      Quote[]         @relation("QuotesCreated")
  quoteVersions      QuoteVersion[]  @relation("QuoteVersionsChanged")
  invoicesCreated    Invoice[]       @relation("InvoicesCreated")
  invoicesSold       Invoice[]       @relation("InvoicesSold")
  creditNotesCreated CreditNote[]    @relation("CreditNotesCreated")
  paymentsReceived   Payment[]       @relation("PaymentsReceived")
  purchaseOrders     PurchaseOrder[] @relation("PurchaseOrdersCreated")
  auditLogs          AuditLog[]

  @@map("users")
}

// ============================================
// CLIENTS (CRM Core)
// ============================================

model Client {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?
  notes         String?
  status        String    @default("active") // active, inactive, prospect
  navigatorId   String?   @unique @map("navigator_id") // Navigator v1 client ID
  createdById   String    @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  createdBy     User      @relation(fields: [createdById], references: [id])
  projects      Project[]
  contacts      Contact[]

  // Financial relations
  quotes        Quote[]
  invoices      Invoice[]
  creditNotes   CreditNote[]

  @@index([status])
  @@index([createdById])
  @@map("clients")
}

// ============================================
// CONTACTS (Client contacts)
// ============================================

model Contact {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  name          String
  email         String?
  phone         String?
  role          String?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  name          String
  description   String?
  status        String    @default("draft") // draft, active, completed, cancelled
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  budget        Decimal?  @db.Decimal(10, 2)
  navigatorId   String?   @unique @map("navigator_id") // Navigator v1 project ID
  navigatorRef  String?   @map("navigator_ref") // Navigator project numero (PRJ-xxx)
  buId          String?   @map("bu_id") @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  client        Client    @relation(fields: [clientId], references: [id])
  owner         User      @relation(fields: [ownerId], references: [id])
  bu            BusinessUnit? @relation("ProjectBU", fields: [buId], references: [id])
  tasks         Task[]
  projectProducts ProjectProduct[]

  // Financial relations
  quotes              Quote[]
  invoices            Invoice[]
  purchaseOrders      PurchaseOrder[]
  timeEntries         TimeEntry[]
  expenses            Expense[]
  revenueAllocations  RevenueAllocation[]

  @@index([clientId])
  @@index([status])
  @@index([buId])
  @@map("projects")
}

// ============================================
// TASKS
// ============================================

model Task {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String?   @map("project_id") @db.Uuid
  title         String
  description   String?
  status        String    @default("todo") // todo, in_progress, done, cancelled
  priority      String    @default("medium") // low, medium, high, urgent
  dueDate       DateTime? @map("due_date")
  assigneeId    String?   @map("assignee_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?     @relation(fields: [assigneeId], references: [id])

  @@map("tasks")
}

// ============================================
// NOTES (Activity log)
// ============================================

model Note {
  id            String    @id @default(uuid()) @db.Uuid
  content       String
  entityType    String    @map("entity_type") // client, project, task
  entityId      String    @map("entity_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("notes")
}

// ============================================
// CATALOGUE PRODUITS
// ============================================

model ProductCategory {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  slug          String    @unique
  description   String?
  parentId      String?   @map("parent_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  parent        ProductCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      ProductCategory[] @relation("CategoryHierarchy")
  products      Product[]

  @@map("product_categories")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  sku           String    @unique
  name          String
  description   String?
  categoryId    String?   @map("category_id") @db.Uuid
  price         Decimal?  @db.Decimal(10, 2)
  cost          Decimal?  @db.Decimal(10, 2)
  taxRate       Decimal   @default(20) @map("tax_rate") @db.Decimal(5, 2)
  stock         Int       @default(0)
  unit          String?   // piece, meter, kg, etc.
  status        String    @default("active") // active, inactive, discontinued
  images        String[]  // Array of image URLs
  specifications Json?    // Flexible JSON for custom fields
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  projectProducts ProjectProduct[]

  // Financial relations
  quoteItems          QuoteItem[]
  invoiceItems        InvoiceItem[]
  creditNoteItems     CreditNoteItem[]
  purchaseOrderItems  PurchaseOrderItem[]

  @@map("products")
}

// ============================================
// PRODUCTS <> PROJECTS (Junction)
// ============================================

model ProjectProduct {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  quantity      Int       @default(1)
  price         Decimal?  @db.Decimal(10, 2) // Price at time of quote
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])

  @@unique([projectId, productId])
  @@map("project_products")
}

// ============================================
// BUSINESS UNITS (BU)
// ============================================

model BusinessUnit {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  code      String   @unique  // e.g., "PROD", "ATELIER", "POST"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  projects        Project[]     @relation("ProjectBU")
  invoicesSales   Invoice[]     @relation("InvoiceSalesBU")
  itemsProductive InvoiceItem[] @relation("ItemProductiveBU")

  @@map("business_units")
}

// ============================================
// SUPPLIERS
// ============================================

model Supplier {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  email                String?
  phone                String?
  company              String?
  address              String?
  siret                String?
  notes                String?
  status               String    @default("active")
  accessToken          String?   @unique @map("access_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  purchaseOrders   PurchaseOrder[]
  supplierInvoices SupplierInvoice[]

  @@map("suppliers")
}

// ============================================
// QUOTES (Devis)
// ============================================

model Quote {
  id             String      @id @default(uuid()) @db.Uuid
  reference      String      @unique
  version        Int         @default(1)
  clientId       String      @map("client_id") @db.Uuid
  projectId      String?     @map("project_id") @db.Uuid
  createdById    String      @map("created_by_id") @db.Uuid
  status         QuoteStatus @default(DRAFT)
  validUntil     DateTime?   @map("valid_until")
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  taxRate        Decimal     @default(20) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  discountType   DiscountType @default(PERCENTAGE) @map("discount_type")
  total          Decimal     @default(0) @db.Decimal(12, 2)
  clientPONumber String?     @map("client_po_number")
  notes          String?
  terms          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  client         Client      @relation(fields: [clientId], references: [id])
  project        Project?    @relation(fields: [projectId], references: [id])
  createdBy      User        @relation("QuotesCreated", fields: [createdById], references: [id])
  items          QuoteItem[]
  versions       QuoteVersion[]
  invoices       Invoice[]
  milestones     QuoteMilestone[]

  @@index([clientId])
  @@index([status])
  @@index([projectId])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid()) @db.Uuid
  quoteId     String   @map("quote_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  description String
  section     String?
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  taxRate     Decimal  @default(20) @map("tax_rate") @db.Decimal(5, 2)
  total       Decimal  @default(0) @db.Decimal(12, 2)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@map("quote_items")
}

model QuoteVersion {
  id          String   @id @default(uuid()) @db.Uuid
  quoteId     String   @map("quote_id") @db.Uuid
  version     Int
  data        Json
  changedById String   @map("changed_by_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at")

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  changedBy   User     @relation("QuoteVersionsChanged", fields: [changedById], references: [id])

  @@map("quote_versions")
}

model QuoteMilestone {
  id         String   @id @default(uuid()) @db.Uuid
  quoteId    String   @map("quote_id") @db.Uuid
  label      String   // "Acompte commande", "Fin tournage", "Livraison"
  percentage Decimal  @db.Decimal(5, 2)
  position   Int
  invoiceId  String?  @unique @map("invoice_id") @db.Uuid

  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("quote_milestones")
}

// ============================================
// INVOICES (Factures)
// ============================================

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  reference       String        @unique
  quoteId         String?       @map("quote_id") @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  projectId       String?       @map("project_id") @db.Uuid
  createdById     String        @map("created_by_id") @db.Uuid
  status          InvoiceStatus @default(DRAFT)
  situationNumber Int?          @map("situation_number")
  issueDate       DateTime      @default(now()) @map("issue_date")
  dueDate         DateTime      @map("due_date")
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  taxRate         Decimal       @default(20) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid      Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  amountDue       Decimal       @default(0) @map("amount_due") @db.Decimal(12, 2)
  clientPONumber  String?       @map("client_po_number")
  situationTotal  Int?          @map("situation_total") // Nombre total de situations (ex: 3)
  sellerId        String?       @map("seller_id") @db.Uuid
  salesBuId       String?       @map("sales_bu_id") @db.Uuid
  notes           String?
  terms           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  quote          Quote?        @relation(fields: [quoteId], references: [id])
  client         Client        @relation(fields: [clientId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])
  createdBy      User          @relation("InvoicesCreated", fields: [createdById], references: [id])
  seller         User?         @relation("InvoicesSold", fields: [sellerId], references: [id])
  salesBu        BusinessUnit? @relation("InvoiceSalesBU", fields: [salesBuId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]
  schedule       PaymentSchedule[]
  creditNotes    CreditNote[]
  milestone      QuoteMilestone?

  @@index([clientId])
  @@index([status])
  @@index([projectId])
  @@index([status, dueDate])
  @@index([sellerId])
  @@index([salesBuId])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  description    String
  section        String?
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(20) @map("tax_rate") @db.Decimal(5, 2)
  total          Decimal  @default(0) @db.Decimal(12, 2)
  productiveBuId String?  @map("productive_bu_id") @db.Uuid
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id])
  productiveBu BusinessUnit? @relation("ItemProductiveBU", fields: [productiveBuId], references: [id])

  @@map("invoice_items")
}

// ============================================
// CREDIT NOTES (Avoirs)
// ============================================

model CreditNote {
  id              String           @id @default(uuid()) @db.Uuid
  reference       String           @unique
  invoiceId       String           @map("invoice_id") @db.Uuid
  clientId        String           @map("client_id") @db.Uuid
  createdById     String           @map("created_by_id") @db.Uuid
  status          CreditNoteStatus @default(DRAFT)
  issueDate       DateTime         @default(now()) @map("issue_date")
  subtotal        Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total           Decimal          @default(0) @db.Decimal(12, 2)
  reason          String?
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  invoice         Invoice          @relation(fields: [invoiceId], references: [id])
  client          Client           @relation(fields: [clientId], references: [id])
  createdBy       User             @relation("CreditNotesCreated", fields: [createdById], references: [id])
  items           CreditNoteItem[]

  @@map("credit_notes")
}

model CreditNoteItem {
  id            String     @id @default(uuid()) @db.Uuid
  creditNoteId  String     @map("credit_note_id") @db.Uuid
  productId     String?    @map("product_id") @db.Uuid
  description   String
  quantity      Decimal    @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal    @map("unit_price") @db.Decimal(12, 2)
  taxRate       Decimal    @default(20) @map("tax_rate") @db.Decimal(5, 2)
  total         Decimal    @default(0) @db.Decimal(12, 2)
  position      Int        @default(0)
  createdAt     DateTime   @default(now()) @map("created_at")

  creditNote    CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product       Product?   @relation(fields: [productId], references: [id])

  @@map("credit_note_items")
}

// ============================================
// PAYMENTS (Paiements)
// ============================================

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  reference    String        @unique
  invoiceId    String        @map("invoice_id") @db.Uuid
  receivedById String        @map("received_by_id") @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(BANK_TRANSFER)
  status       PaymentStatus @default(PENDING)
  paidAt       DateTime?     @map("paid_at")
  notes        String?
  isDeposit    Boolean       @default(false) @map("is_deposit")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  receivedBy   User          @relation("PaymentsReceived", fields: [receivedById], references: [id])

  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

model PaymentSchedule {
  id                 String   @id @default(uuid()) @db.Uuid
  invoiceId          String   @map("invoice_id") @db.Uuid
  installmentNumber  Int      @map("installment_number")
  amount             Decimal  @db.Decimal(12, 2)
  dueDate            DateTime @map("due_date")
  status             String   @default("pending") // pending, paid, overdue
  paidAt             DateTime? @map("paid_at")
  createdAt          DateTime @default(now()) @map("created_at")

  invoice            Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_schedules")
}

// ============================================
// PURCHASE ORDERS (Bons de Commande)
// ============================================

model PurchaseOrder {
  id               String   @id @default(uuid()) @db.Uuid
  reference        String   @unique
  supplierId       String   @map("supplier_id") @db.Uuid
  projectId        String?  @map("project_id") @db.Uuid
  createdById      String   @map("created_by_id") @db.Uuid
  status           POStatus @default(DRAFT)
  orderDate        DateTime @default(now()) @map("order_date")
  expectedDelivery DateTime? @map("expected_delivery")
  subtotal         Decimal  @default(0) @db.Decimal(12, 2)
  taxRate          Decimal  @default(20) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total            Decimal  @default(0) @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  supplier         Supplier @relation(fields: [supplierId], references: [id])
  project          Project? @relation(fields: [projectId], references: [id])
  createdBy        User     @relation("PurchaseOrdersCreated", fields: [createdById], references: [id])
  items            PurchaseOrderItem[]
  supplierInvoices SupplierInvoice[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  productId       String?       @map("product_id") @db.Uuid
  description     String
  quantity        Decimal       @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  position        Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at")

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id") @db.Uuid
  changes    Json?
  metadata   Json?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// COMPANY SETTINGS (Singleton)
// ============================================

model CompanySettings {
  id                   String   @id @default(uuid()) @db.Uuid
  companyName          String   @default("Sheriff Projects") @map("company_name")
  legalForm            String?  @map("legal_form")        // SARL, SAS, EI, etc.
  shareCapital         String?  @map("share_capital")      // Capital social
  siret                String?
  siren                String?
  rcsNumber            String?  @map("rcs_number")
  rcsCity              String?  @map("rcs_city")
  tvaIntracom          String?  @map("tva_intracom")       // TVA intracommunautaire
  apeCode              String?  @map("ape_code")           // Code APE/NAF
  address              String?
  phone                String?
  email                String?
  website              String?
  logo                 String?
  iban                 String?
  bic                  String?
  latePenaltyRate      Decimal? @map("late_penalty_rate") @db.Decimal(5, 2)
  earlyPaymentDiscount String?  @map("early_payment_discount")
  legalFooter          String?  @map("legal_footer")
  defaultTaxRate       Decimal  @default(20) @map("default_tax_rate") @db.Decimal(5, 2)
  defaultPaymentTerms  Int      @default(30) @map("default_payment_terms")
  quotePrefix          String   @default("DEV") @map("quote_prefix")
  invoicePrefix        String   @default("FAC") @map("invoice_prefix")
  creditNotePrefix     String   @default("AV") @map("credit_note_prefix")
  poPrefix             String   @default("PO") @map("po_prefix")
  paymentPrefix        String   @default("PAY") @map("payment_prefix")
  nextQuoteNumber      Int      @default(1) @map("next_quote_number")
  nextInvoiceNumber    Int      @default(1) @map("next_invoice_number")
  nextCreditNoteNumber Int      @default(1) @map("next_credit_note_number")
  nextPONumber         Int      @default(1) @map("next_po_number")
  nextPaymentNumber    Int      @default(1) @map("next_payment_number")
  counterYear          Int      @default(2026) @map("counter_year")
  currency             String   @default("EUR")
  locale               String   @default("fr-FR")
  acAccountId          String?  @map("ac_account_id")      // ActiveCollab Cloud account ID
  acApiToken           String?  @map("ac_api_token")       // ActiveCollab API token
  acSyncEnabled        Boolean  @default(false) @map("ac_sync_enabled")
  acLastSyncAt         DateTime? @map("ac_last_sync_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

// ============================================
// TIME TRACKING
// ============================================

model TimeEntry {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  taskId      String?   @map("task_id") @db.Uuid
  description String?
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  duration    Int?      // Duration in minutes (auto-calculated or manual)
  hourlyRate  Decimal?  @map("hourly_rate") @db.Decimal(10, 2)
  billable    Boolean   @default(true)
  invoiced    Boolean   @default(false)
  invoiceId   String?   @map("invoice_id") @db.Uuid
  acId        Int?      @unique @map("ac_id")           // ActiveCollab time record ID
  acProjectId Int?      @map("ac_project_id")            // ActiveCollab project ID
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([billable, invoiced])
  @@map("time_entries")
}

// ============================================
// EXPENSE TRACKING
// ============================================

model Expense {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  category    String    // transport, location, catering, equipment, props, other
  description String
  amount      Decimal   @db.Decimal(12, 2)
  date        DateTime  @default(now())
  receiptUrl  String?   @map("receipt_url")
  billable    Boolean   @default(true)
  markupPercent Decimal @default(0) @map("markup_percent") @db.Decimal(5, 2)
  invoiced    Boolean   @default(false)
  invoiceId   String?   @map("invoice_id") @db.Uuid
  acId        Int?      @unique @map("ac_id")           // ActiveCollab expense ID
  acProjectId Int?      @map("ac_project_id")            // ActiveCollab project ID
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([billable, invoiced])
  @@index([category])
  @@map("expenses")
}

// ============================================
// SUPPLIER INVOICES (Extranet uploads)
// ============================================

model SupplierInvoice {
  id              String                @id @default(uuid()) @db.Uuid
  supplierId      String                @map("supplier_id") @db.Uuid
  purchaseOrderId String                @map("purchase_order_id") @db.Uuid
  reference       String                // supplier's own invoice reference
  fileName        String                @map("file_name")
  fileData        Bytes                 @map("file_data")
  fileSize        Int                   @map("file_size")
  amount          Decimal?              @db.Decimal(12, 2)
  status          SupplierInvoiceStatus @default(SUBMITTED)
  notes           String?
  reviewNotes     String?               @map("review_notes")
  submittedAt     DateTime              @default(now()) @map("submitted_at")
  reviewedAt      DateTime?             @map("reviewed_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("supplier_invoices")
}

// ============================================
// REVENUE ALLOCATION (Cut-off comptable)
// ============================================

model RevenueAllocation {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  month      String   // "YYYY-MM" format (e.g., "2026-02")
  percentage Decimal  @db.Decimal(5, 2) // 0-100
  amount     Decimal? @db.Decimal(12, 2) // calculated: project revenue * percentage / 100
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month])
  @@index([month])
  @@map("revenue_allocations")
}
