// KWOT CRM - Database Schema
// Generator and datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTH
// ============================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String
  role          String    @default("user") // admin, manager, user
  avatar        String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  clients       Client[]
  projects      Project[]
  tasks         Task[]

  @@map("users")
}

// ============================================
// CLIENTS (CRM Core)
// ============================================

model Client {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?
  notes         String?
  status        String    @default("active") // active, inactive, prospect
  createdById   String    @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  createdBy     User      @relation(fields: [createdById], references: [id])
  projects      Project[]
  contacts      Contact[]

  @@map("clients")
}

// ============================================
// CONTACTS (Client contacts)
// ============================================

model Contact {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  name          String
  email         String?
  phone         String?
  role          String?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  name          String
  description   String?
  status        String    @default("draft") // draft, active, completed, cancelled
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  budget        Decimal?  @db.Decimal(10, 2)
  ownerId       String    @map("owner_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  client        Client    @relation(fields: [clientId], references: [id])
  owner         User      @relation(fields: [ownerId], references: [id])
  tasks         Task[]

  @@map("projects")
}

// ============================================
// TASKS
// ============================================

model Task {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String?   @map("project_id") @db.Uuid
  title         String
  description   String?
  status        String    @default("todo") // todo, in_progress, done, cancelled
  priority      String    @default("medium") // low, medium, high, urgent
  dueDate       DateTime? @map("due_date")
  assigneeId    String?   @map("assignee_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?     @relation(fields: [assigneeId], references: [id])

  @@map("tasks")
}

// ============================================
// NOTES (Activity log)
// ============================================

model Note {
  id            String    @id @default(uuid()) @db.Uuid
  content       String
  entityType    String    @map("entity_type") // client, project, task
  entityId      String    @map("entity_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("notes")
}
